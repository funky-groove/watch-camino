<?xml version="1.0" encoding="utf-8"?>
<!-- Nada sale del reloj por copia de seguridad ni por transferencia entre dispositivos (spec §11). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
